# dependencias
node_modules/
.pnpm-store/

# builds
# Ojo: nada de patrones sueltos como "build/", porque también ignorarían
# db/build/, que sí va versionado.
dist/
apps/*/build/
packages/*/build/
.next/
.expo/
*.tsbuildinfo

# secretos — nunca subir
.env
.env.*
!.env.example
*.pem
*.p8
*.p12
*.keystore
google-services.json
GoogleService-Info.plist

# sistema
.DS_Store
Thumbs.db
*.log

# python
__pycache__/
*.pyc
.venv/

# datos locales
pgdata/
*.sqlite
*.db
