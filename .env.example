# Copia este archivo a .env y llena los valores. .env nunca se sube.

# --- base de datos ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prlab
REDIS_URL=redis://localhost:6379

# --- autenticación ---
JWT_SECRET=cambiar-por-un-valor-largo-y-aleatorio
JWT_ACCESS_TTL=900          # segundos
JWT_REFRESH_TTL=2592000     # 30 días

# --- almacenamiento de video e imágenes ---
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_URL=

# --- notificaciones ---
PUSH_PROVIDER_KEY=

# --- relojes (ninguno aprobado todavía; ver docs) ---
SUUNTO_CLIENT_ID=
SUUNTO_CLIENT_SECRET=
COROS_CLIENT_ID=
COROS_CLIENT_SECRET=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# --- IA (Versión 2; apagada por bandera) ---
FEATURE_IA=false
IA_PROVIDER_API_KEY=

# --- cobros (Versión 2) ---
FEATURE_COBROS=false
