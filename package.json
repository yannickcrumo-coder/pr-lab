{
  "name": "pr-lab",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "db:migrate": "psql -v ON_ERROR_STOP=1 -f db/migrations/0001_init.sql",
    "db:seed": "psql -v ON_ERROR_STOP=1 -f db/migrations/0002_seed_reference.sql",
    "db:test": "psql -v ON_ERROR_STOP=1 -f db/tests/smoke.sql",
    "db:build-seed": "cd db/build && python3 build.py && python3 make_seed_sql.py",
    "api:validate": "python3 api/validate.py"
  }
}
